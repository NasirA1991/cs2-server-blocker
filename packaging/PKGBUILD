# Maintainer: NasirA1991 <nasir@users.noreply.github.com>
pkgname=cs2blocker
pkgver=0.1.3
pkgrel=1
pkgdesc="Block CS2 matchmaking datacenters with persistent nftables rules"
arch=('any')
url="https://github.com/NasirA1991/cs2-server-blocker"
license=('MIT')
depends=('python>=3.11' 'nftables' 'polkit' 'systemd' 'python-gobject' 'python-cairo' 'gtk4' 'libadwaita>=1.4')
optdepends=('ipset: iptables/ipset fallback when nftables is unavailable')
makedepends=('git')
_repo_root=$(realpath "$startdir/..")
source=("$pkgname::git+file://$_repo_root")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname"
  bash packaging/install.sh --root "$pkgdir" --no-daemon-reload
}
