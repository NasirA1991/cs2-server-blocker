#!/usr/bin/python3 -I
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("cs2blocker requires Python 3.11 or newer\n")
    raise SystemExit(1)

BASE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(BASE, "lib", "cs2blocker"))
from cs2blocker.cli import main

raise SystemExit(main())
