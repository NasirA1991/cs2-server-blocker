#!/usr/bin/python3 -I
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("cs2blocker requires Python 3.11 or newer\n")
    raise SystemExit(1)

try:
    import gi

    gi.require_version("Adw", "1")
    from gi.repository import Adw
except Exception as exc:  # pragma: no cover - depends on the host
    sys.stderr.write(f"cs2blocker requires GTK4 and libadwaita: {exc}\n")
    raise SystemExit(1)

if (Adw.MAJOR_VERSION, Adw.MINOR_VERSION) < (1, 5):
    sys.stderr.write(
        f"cs2blocker requires libadwaita 1.5 or newer (found {Adw.MAJOR_VERSION}.{Adw.MINOR_VERSION})\n"
    )
    raise SystemExit(1)

BASE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(BASE, "lib", "cs2blocker"))
from cs2blocker.gui.app import main  # noqa: E402

raise SystemExit(main())
